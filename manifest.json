{
    "manifest_version": 3,
    "name": "Reel Blocker",
    "version": "1.0",
    "permissions": ["storage"], 

    "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
    "host_permissions":[
        "https://www.youtube.com/*",
        "https://www.facebook.com/*"
    ],
    "content_scripts": [
        {
            "matches":[
                "https://www.youtube.com/*",
                "https://www.facebook.com/*"
            ],
            "js": ["content.js"]
        }
    ],
    "action": {
        "default_popup" : "popup.html"
    }
}